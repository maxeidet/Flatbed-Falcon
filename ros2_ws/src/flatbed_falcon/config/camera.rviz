# RViz layout for ros2_ws/view-camera.sh: the drone's gimbal camera, nothing else.
# The image comes from the lazy bridge in bridge.yaml, so it only flows while RViz is open.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Gimbal camera
      Enabled: true
      Topic:
        Value: /falcon/camera/image
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
Window Geometry:
  Height: 760
  Width: 1100
